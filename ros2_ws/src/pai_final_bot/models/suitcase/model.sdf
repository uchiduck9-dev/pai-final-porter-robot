<?xml version='1.0' encoding='utf-8'?>
<!-- Gazebo Fuel の OpenRobotics/Suitcase2 を元に、ロボットで運べるよう変更:
     固定（static）をやめて重さ（0.5kg）を付け、当たり判定を単純な箱にした。大きさ 0.21 x 0.35 x 0.55 m -->
<sdf version="1.6">
    <model name="Suitcase2">
        <link name="body">
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.27 0 0 0</pose>
                <!-- 荷台の後ろ寄りに載せるため、ロボットが後ろに倒れないよう軽めにする -->
                <mass>0.5</mass>
                <inertia>
                    <ixx>0.0172</ixx><iyy>0.0140</iyy><izz>0.0070</izz>
                    <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
                </inertia>
            </inertial>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://suitcase/meshes/Suitcase2.obj</uri>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision">
                <pose>0 0 0.27 0 0 0</pose>
                <geometry>
                    <box><size>0.21 0.34 0.54</size></box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>
